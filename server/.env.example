PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Created on first start only, if no users exist. Change the password after logging in.
ADMIN_EMAIL=admin@zealweb.xyz
ADMIN_PASSWORD=change-this-password
# Frontend origin(s) allowed to call the API, comma separated. Needed only if the client is hosted separately (e.g. Vercel).
CLIENT_ORIGIN=http://localhost:5173
# Path to the SQLite file. On Render/Railway/Fly point this at a persistent volume, e.g. /data/zeal.db
DB_PATH=./data/zeal.db

# ---- Email alerts for new messages and bookings (pick ONE option) ----
# Option A, Resend (https://resend.com): create an API key. Until you verify a domain, the test sender can
# only deliver to the email you signed up to Resend with.
RESEND_API_KEY=
# Where alerts go (defaults to ADMIN_EMAIL)
NOTIFY_TO=
# Sender shown on alerts. Use an address on a domain you verified in Resend, e.g. ZEAL <hello@zealweb.xyz>
MAIL_FROM=ZEAL <onboarding@resend.dev>
# Option B, SMTP (leave RESEND_API_KEY empty): your provider's server and an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
